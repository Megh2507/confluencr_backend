# Postgres connection string from Neon / Supabase / Render. Omit to use a local SQLite file.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional tuning (defaults shown)
# PROCESSING_DELAY_SECONDS=30
# ACK_DEADLINE_MS=300
# SWEEP_INTERVAL_SECONDS=5
# LEASE_GRACE_SECONDS=30
# MAX_ATTEMPTS=5
# RETRY_BACKOFF_SECONDS=5
# MAX_CONCURRENT_JOBS=500
# LOG_LEVEL=INFO
